<?php
//get collection and order by random
$storeId = Mage::app()->getStore()->getStoreId();
$questions = Mage::getModel('productquestions/questions')->getCollection();
$questions
    ->addFieldToFilter('approved',0)
    ->addFieldToFilter('store_ids',array('finset'=>$storeId))
    ->addFieldToFilter('private',0)
    ->addFieldToFilter('answer',array('notnull'=>true))
    ->getSelect()
    ->order("rand()")
    ->limit($this->getQuestionCount())
;
?>

<div class="qw-widget-container">
    <?php if($title = $this->getWidgetTitle()){?>
        <div class="qw-title">
            <h3><?php echo $title;?></h3>
        </div>
    <?php } ?>
    <ul id="qw_<?php echo $id = uniqid();?>" class="qw-widget">
        <?php
        $productResource = Mage::getResourceModel('catalog/product');
        foreach($questions as $question){ ?>
            <?php
            $_product = Mage::getModel('catalog/product')
                ->getCollection()
                ->addAttributeToSelect(array('thumbnail','name','url_path','url_key'))
                ->addAttributeToFilter('entity_id',$question->getProductId())
                ->addStoreFilter($storeId)
                ->getFirstItem();
            ?>
            <li class="qw-item" onclick="window.location.href = '<?php echo Mage::getBaseUrl() . $_product->getUrlPath(); ?>'">
                <div class="qw-img-container">
                    <div class="imgwrap">
                        <img class="qw-image" src="<?php echo Mage::helper('catalog/image')->init($_product, 'thumbnail')->resize(90); ?>" />
                    </div>
                </div>
                <div class="qw-content">
                    <h4 class="qw-product-title"><?php echo $_product->getName(); ?></h4>
                    <div class="qw-qa">
                        <span class="qw-icon">Q</span>
                        <div class="qw-text">
                            <?php echo strip_tags($question->getQuestion()); ?>
                        </div>
                    </div>
                    <?php if($question->getAnswer()){ ?>
                        <div class="qw-qa">
                            <span class="qw-icon qw-icon-ans">A</span>
                            <div class="qw-text">
                                <?php echo strip_tags($question->getAnswer()); ?>
                            </div>
                        </div>
                    <?php } ?>
                </div>
            </li>
        <?php } ?>
    </ul>
</div>

