<script type="text/javascript">
    jQuery(function($) {
        console.log('asdasd');
        $('.qw-text').each(function(index,element) {
            $clamp(element, {clamp: 2});
        })

        var iHeight = 0;
        $('#qw_<?php echo $id;?> .qw-content').each(function() {
            if($(this).height() > iHeight) {
                iHeight = $(this).height();
            }
        })

        console.log(iHeight);
        $('#qw_<?php echo $id;?> .qw-content').css('height', iHeight + 'px');

        iHeight = 0;
        $('#qw_<?php echo $id;?> .qw-text').each(function() {
            if($(this).height() > iHeight) {
                iHeight = $(this).height();
            }
        })
        $('#qw_<?php echo $id;?> .qw-text').css('height', iHeight + 'px');


        setTimeout(function() {
            var height = $('#qw_<?php echo $id; ?> .qw-item').first().outerHeight();
            console.log(height);
            var pw_widget = $('#qw_<?php echo $id; ?>').newsTicker({
                row_height: height,
                max_rows: <?php echo $this->getRowCount();?>,
                duration: 8000
            });
        },300)

        $('.qw-widget-container').each(function() {
            var item = jQuery(this);
            if(item.width() < 300){
                item.find('.qw-img-container').hide();
                item.find('.qw-content').css({'width':'100%','padding-left':'0px','padding-right': '0px'});
                item.find('.qw-title').css('font-size', '14px').addClass('block-title');
                item.find('.qw-product-title').css('font-size', '12px');
                item.find('.qw-title h3').css('font-size', '14px');
            }else{
                item.find('.qw-img-container').show();
            }

        })
    })
</script>

